# ~/.claude-usage/.env on the Mac (mode 600). Only used by `cc-push`.

# Where Claude Code writes its transcripts on this Mac
CLAUDE_CODE_LOG_DIR=~/.claude/projects
# The Pi's dashboard ingest URL, via tailscale serve, e.g. https://distiller-35ed.your-tailnet.ts.net/api/cc-hourly
CC_PUSH_URL=
# Must equal CC_INGEST_TOKEN in /opt/claude-usage/.env on the Pi
CC_PUSH_TOKEN=
# Name shown on the dashboard for this machine (default: hostname)
CC_SOURCE_NAME=
# Same timezone as the Pi
TZ_NAME=America/New_York
# Local scan state (message IDs and token counts only)
CLAUDE_USAGE_DB=~/.claude-usage/cc.db
