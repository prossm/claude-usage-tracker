# Copy to /opt/claude-usage/.env (owner claudeusage, mode 600). Never commit real values.

# cookie (default) or oauth
CLAUDE_AUTH_MODE=
# Cookie mode: the sessionKey cookie from a logged-in claude.ai browser session (starts with sk-ant-sid)
CLAUDE_SESSION_KEY=
# Optional organization UUID; discovered at runtime if empty
CLAUDE_ORG_ID=

# Notion internal integration token, and the ID (or URL) of the daily rollup database
NOTION_TOKEN=
NOTION_DATABASE_ID=
# Only needed if the database has more than one data source (sync tells you the IDs)
NOTION_DATA_SOURCE_ID=

# Slack incoming webhook for alerts
SLACK_WEBHOOK_URL=

# Timezone that defines a "day" for rollups (IANA name), e.g. America/New_York
TZ_NAME=

# Optional: Claude Code project logs (e.g. /home/pi/.claude/projects). Empty = token module skipped
CLAUDE_CODE_LOG_DIR=

# Optional: alert once per weekly window when weekly usage crosses this percentage
ALERT_WEEKLY_PCT=

# --- Optional tuning (defaults shown in comments) ---
# OAuth mode: path to Claude Code's credentials file, read-only (~/.claude/.credentials.json)
CLAUDE_OAUTH_CREDENTIALS=
# curl_cffi impersonation profile for claude.ai (firefox133)
CLAUDE_IMPERSONATE=
# Adaptive polling: fast interval (30), ceiling (300), unchanged polls before backing off (3),
# snap-to-fast window before a reset (120), max seconds between persisted rows (900)
POLL_FAST_SECONDS=
POLL_MAX_SECONDS=
POLL_IDLE_THRESHOLD=
POLL_RESET_BURST_SECONDS=
POLL_HEARTBEAT_SECONDS=
